# 「是啊吃什么」部署参数模板（§12 M6）
# 用法：复制为 doc/docker/.env（compose 自动读取），或 export 同名变量
# ── LLM（必填） ─────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 展示名 / 端口 ───────────────────────────────────────
VITE_APP_NAME=是啊吃什么
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ── 关系型：PostgreSQL（企业级模式；Lite 模式用 SQLite 不涉及） ──
PG_USER=postgres
PG_PASSWORD=postgres123
PG_DB=yeahwhat2eat
PG_PORT=5432

# ── 向量库（企业级默认 Milvus；Lite 模式为 Qdrant 文件嵌入不涉及） ──
VECTOR_STORE_PROVIDER=milvus        # milvus | qdrant（企业级也可用 qdrant 容器）
MILVUS_TOKEN=                       # Milvus 无认证则留空
MILVUS_PORT=19530
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── 图库（企业级默认 Neo4j；Lite 模式为 Kùzu 嵌入式不涉及） ──
GRAPH_STORE_PROVIDER=neo4j          # neo4j | kuzu
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_URI=bolt://localhost:7687     # 本机测试（容器内自动用 neo4j:7687）

# ── 安全（生产必须修改） ─────────────────────────────────
JWT_SECRET=change-me-to-random-32+bytes
APP_ENV=prod
