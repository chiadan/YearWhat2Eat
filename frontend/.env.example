# ─────────────────────────────────────────────────────────────
# frontend/.env.example → 手动复制为 frontend/.env
# VITE_ 前缀才会打进前端包（构建期注入，§12.2）
# ─────────────────────────────────────────────────────────────

# 开发模式：指向本地后端（Vite dev server，vite.config 已配 /api 代理）
VITE_API_BASE_URL=http://localhost:8000/api/v1
# 生产构建：同源相对路径，由 nginx 反代 /api -> backend（Dockerfile ARG 覆盖此值）
# VITE_API_BASE_URL=/api/v1

# 应用展示名：浏览器标题 / 页面 Header / 欢迎语（默认"是啊吃什么"，可修改，§10）
VITE_APP_NAME=是啊吃什么

# 生产容器对外端口（compose 映射 ${FRONTEND_PORT:-8080}:80 读取本键）
FRONTEND_PORT=8080
